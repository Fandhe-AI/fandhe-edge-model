#!/bin/sh
# Claude Code プラグインの判定ラッパー（REQ-33・REQ-36・REQ-38・#726・#729）。
#
# skill `judge` から `fandhe-edge-judge --text "<入力>"` の形で呼ばれる。
# 呼ぶたびに常駐 `fandhe-edge serve` を裏で起動し（動いていれば serve 側が
# 読み込み前に終わる）、続けて `fandhe-edge infer` を実行して、その stdout
# （JSON 1 つ）と終了コード（REQ-21 の 7 種）をそのまま返す。初回の判定は
# 常駐の準備を待たず、infer が単独で行う。
#
# 環境変数:
#   FANDHE_EDGE_PACKAGE         必須。パッケージのパス（絶対パス推奨）。プロジェクトの
#                               外（例: ~/.fandhe-edge/package）に 1 つ置き、どの
#                               プロジェクトからも使える
#   FANDHE_EDGE_IDLE_EXIT_SECS  任意（既定 600。#710 の計測後に見直す推定値）。
#                               使われない常駐が自分で終わるまでの秒数
#
# ガード層（REQ-39）は --package をカレントディレクトリ配下に閉じ込める。
# パッケージの親ディレクトリへ移ってから名前だけを渡すことで、閉じ込めを
# 緩めずにプロジェクト外のパッケージを使う。パスは利用者自身の設定から
# 来るもので、エージェントの入力ではない。移った後は "$@" の相対パスも
# 親ディレクトリ基準になる（skill はパスを取る引数を渡さない）。
#
# 名前を `fandhe-edge` にしないのは、PATH 上の本体を隠して自分自身を
# 呼ぶ再帰を避けるため。引数は "$@" のみで、eval・文字列連結は使わない。

# エラーは CLI の ErrorReport と同形の JSON 1 行を stdout へ出す。
# メッセージは固定文で、環境変数の値や入力を埋め込まない。
fail() {
    printf '{"code":"%s","message":"%s"}\n' "$1" "$2"
    exit "$3"
}

if [ -z "${FANDHE_EDGE_PACKAGE:-}" ]; then
    fail invalid_input "FANDHE_EDGE_PACKAGE is not set" 64
fi

idle="${FANDHE_EDGE_IDLE_EXIT_SECS:-600}"
case "$idle" in
    '' | *[!0-9]* | 0 | 0[0-9]*)
        fail invalid_input "FANDHE_EDGE_IDLE_EXIT_SECS must be an integer of 1 or more" 64
        ;;
esac
# 20 桁以上は u64 を超えうる（CLI の idle_exit_secs は u64）。19 桁までに限る
if [ "${#idle}" -gt 19 ]; then
    fail invalid_input "FANDHE_EDGE_IDLE_EXIT_SECS is too large" 64
fi

if ! bin=$(command -v fandhe-edge 2>/dev/null); then
    fail runtime_error "fandhe-edge is not installed: cargo install --git https://github.com/Fandhe-AI/fandhe-edge-model --tag v0.1.0 --locked fandhe-edge-cli" 70
fi

# 移る前に本体を絶対パスで確定する（PATH の相対エントリは cd 後に別物を指す）
case "$bin" in
    /*) ;;
    *) bin="$PWD/$bin" ;;
esac

# CDPATH を効かせない（別の場所へ移る・移動先が stdout に出て JSON を壊すのを防ぐ）
unset CDPATH
pkg_name=$(basename -- "$FANDHE_EDGE_PACKAGE")
cd -- "$(dirname -- "$FANDHE_EDGE_PACKAGE")" 2>/dev/null ||
    fail invalid_input "cannot enter the parent directory of FANDHE_EDGE_PACKAGE" 64

nohup "$bin" serve --package "$pkg_name" --idle-exit-secs "$idle" >/dev/null 2>&1 </dev/null &

exec "$bin" infer --package "$pkg_name" "$@"
